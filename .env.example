# EnergySignal configuration. Copy to .env and fill in — .env is gitignored.
# Every data source below is free.

# U.S. EIA Open Data — free, instant, email-only signup (key arrives by email):
#   https://www.eia.gov/opendata/register.php
# Powers US48 hourly demand/generation, WTI, Brent, Henry Hub, gasoline/diesel, gas storage.
EIA_API_KEY=

# Ember — free API key (data licensed CC BY 4.0):
#   https://ember-energy.org/data/api/
# Powers monthly electricity demand by country (Electricity page, "Global").
EMBER_API_KEY=

# World Bank Pink Sheet — no key needed (CC BY 4.0).
# This link goes stale when the World Bank republishes; copy the current
# "Monthly prices" Excel link from https://www.worldbank.org/en/research/commodity-markets
PINK_SHEET_URL=https://thedocs.worldbank.org/en/doc/5d903e848db1d1b83e0ec8f744e55570-0350012021/related/CMO-Historical-Data-Monthly.xlsx

# DATABASE_URL defaults to sqlite at <repo>/data/energysignal.db
SCHEDULER_ENABLED=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
